# --- Database -----------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/machinebroker

# --- AI provider --------------------------------------------------------------
# openai | anthropic
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# --- Matching -----------------------------------------------------------------
# embedding | prompt | hybrid
MATCH_STRATEGY=hybrid
MATCH_AUTO_DRAFT_THRESHOLD=80
MATCH_CANDIDATE_LIMIT=25

# --- Email transport ----------------------------------------------------------
# smtp | sendgrid | console (no-op, logs to stdout — default for dev)
EMAIL_TRANSPORT=console
EMAIL_FROM=broker@machinebroker.ai
EMAIL_FROM_NAME=MachineBroker AI

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

SENDGRID_API_KEY=

# --- CORS ---------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000
