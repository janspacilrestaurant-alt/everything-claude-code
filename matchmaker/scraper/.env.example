# Supabase — get these from https://supabase.com/dashboard → your project → Settings → API
SUPABASE_URL=https://xqnwfokmdgtjqqpftchz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Scraper behavior
HEADLESS=1                  # 1 = headless, 0 = visible browser (debug)
CONCURRENCY=2               # how many sources scrape in parallel
MAX_RESULTS_PER_SOURCE=20   # cap per source per run
DRY_RUN=0                   # 1 = print pairs, don't push to Supabase
DEBUG=0                     # 1 = verbose logging

# Bazoš.cz mobile API — leave empty to skip. Set to the 2-char section code
# (e.g. "PR", "DU") once you've probed Bazoš's category endpoint. See
# src/sources/bazos.js for details.
BAZOS_SECTION=

# Residential proxy — optional. Playwright reads these natively. Format:
# http://user:pass@proxy.example.com:8000
# Leave commented out unless you start getting 429/403 from EEN or Surplex.
# HTTPS_PROXY=
# HTTP_PROXY=
# NO_PROXY=localhost,127.0.0.1
