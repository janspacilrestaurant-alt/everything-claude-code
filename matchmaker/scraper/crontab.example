# /etc/cron.d/machinery-deals-scraper
# Runs the daily scraper at 04:17 UTC (off-peak for EU marketplaces).
# Replace /opt/machinery-deals-scraper with your install path.

17 4 * * * root cd /opt/machinery-deals-scraper && /usr/bin/docker compose run --rm scraper >> /var/log/machinery-scraper.log 2>&1
